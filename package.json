{
  "name": "wpai-explorer",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron-main.cjs",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --external:vite --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "desktop": "concurrently \"npm run dev\" \"wait-on http://127.0.0.1:3000/api/health && electron .\"",
    "build:desktop": "npm run dist:win",
    "dist:dir": "npm run build && electron-builder --dir",
    "dist:win": "npm run build && electron-builder --win",
    "dist": "npm run build && electron-builder",
    "preview": "vite preview",
    "docker:ollama": "docker compose up -d ollama && docker compose run --rm ollama-models",
    "docker:up": "docker compose up -d",
    "models:pull": "docker compose run --rm ollama-models",
    "clean": "node -e \"const fs=require('node:fs'); for (const p of ['dist','dist-desktop']) fs.rmSync(p,{recursive:true,force:true});\"",
    "lint": "tsc --noEmit",
    "test": "tsx src/test.ts",
    "populate:data": "tsx scripts/populate-data.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.112.5",
    "@google/genai": "^2.13.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "clsx": "^2.1.1",
    "d3": "^7.9.0",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "framer-motion": "^12.42.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "openai": "^6.48.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tailwind-merge": "^3.6.0",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/d3": "^7.4.3",
    "@types/express": "^5.0.6",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.4",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.1",
    "shell-quote": "^1.10.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.23.1",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "wait-on": "^9.1.0"
  },
  "build": {
    "appId": "com.wpai.explorer.desktop",
    "productName": "WPAI Explorer",
    "directories": {
      "output": "dist-desktop"
    },
    "asar": true,
    "npmRebuild": false,
    "files": [
      "dist/**/*",
      "electron-main.cjs",
      "package.json"
    ],
    "linux": {
      "target": ["AppImage", "dir"],
      "category": "Development"
    },
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "artifactName": "${productName}-${version}-${os}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": ["dmg", "zip"]
    }
  }
}
